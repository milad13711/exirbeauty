# Postgres connection (one shared DB, tenant rows separated by tenantId)
DATABASE_URL="postgresql://USER@localhost:5432/exir_beauty?schema=public"
# >= 32 chars; signs session JWTs. Generate: openssl rand -base64 48
AUTH_SECRET=""
# Used only by `npm run db:seed` to create the first super-admin
SEED_ADMIN_EMAIL="admin@exir.local"
SEED_ADMIN_PASSWORD=""

# SMS for OTP: "limosms" (real, costs credit) or "console" (prints the code in the server log — dev only)
SMS_DRIVER="console"
# Shared secret for the scheduler that calls POST /api/v1/sms/cron/run (reminders, birthdays). Unset = endpoint closed.
CRON_SECRET=""
LIMOSMS_API_KEY=""
LIMOSMS_SENDER=""

# Zarinpal. Sandbox accepts any 36-char UUID as merchant id; production needs the real one with ZARINPAL_SANDBOX="false"
ZARINPAL_SANDBOX="true"
ZARINPAL_MERCHANT_ID=""
# Public base URL used for the payment callback
APP_URL="http://localhost:3100"

# Optional: phone of a demo-salon owner so you can try OTP login (db:seed)
SEED_OWNER_PHONE=""
