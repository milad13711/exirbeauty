# Postgres connection (one shared DB, tenant rows separated by tenantId)
DATABASE_URL="postgresql://USER@localhost:5432/exir_beauty?schema=public"
# >= 32 chars; signs session JWTs. Generate: openssl rand -base64 48
AUTH_SECRET=""
# Used only by `npm run db:seed` to create the first super-admin
SEED_ADMIN_EMAIL="admin@exir.local"
SEED_ADMIN_PASSWORD=""
