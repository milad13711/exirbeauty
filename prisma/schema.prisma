// Exir Beauty — single shared database; tenant-scoped rows carry tenantId.
// Platform-level data (plans, module catalog, finder directory) has no tenantId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  OWNER
  STAFF
  CUSTOMER // a salon customer signed in to the client portal (session only; never stored on User)
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELED
}

enum ModuleScope {
  PLATFORM
  TENANT
}

enum ListingStatus {
  PENDING
  PUBLISHED
  REJECTED
}

// ───────── Plans & module catalog ─────────

model Plan {
  id           String   @id @default(cuid())
  code         String   @unique // free | artist | salon
  title        String
  tagline      String   @default("")
  priceMonthly Int      @default(0) // toman
  // quantitative limits + capability flags, e.g. { "staff": 10, "dashboard": true, "leads": true, "directBooking": true }
  limits       Json     @default("{}")
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  modules       PlanModule[]
  subscriptions Subscription[]
  listings      FinderListing[]
}

// Mirrors code manifests (src/server/modules); synced by `syncCatalog()`.
model Module {
  id               String      @id // manifest id, e.g. "cashier"
  name             String
  description      String      @default("")
  category         String
  scope            ModuleScope @default(TENANT)
  core             Boolean     @default(false) // cannot be uninstalled
  requires         String[]    @default([])
  price            Int         @default(0) // add-on price (toman); admin-editable
  addonPurchasable Boolean     @default(true)
  // Global kill switch (admin): a disabled module is unavailable to every tenant regardless of plan.
  enabled          Boolean     @default(true)
  // Latest released version (semver) — mirrors the manifest; history lives in ModuleVersion.
  version          String      @default("1.0.0")

  plans    PlanModule[]
  tenants  TenantModule[]
  versions ModuleVersion[]
}

// Append-only release history. A new row is written whenever a module's code (checksum) changes,
// and the sync refuses to proceed if the code changed without a version bump.
model ModuleVersion {
  id         String   @id @default(cuid())
  moduleId   String
  version    String
  checksum   String
  changelog  String   @default("")
  releasedAt DateTime @default(now())
  module     Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, version])
  @@index([moduleId, releasedAt])
}

model PlanModule {
  planId   String
  moduleId String
  plan     Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([planId, moduleId])
}

// ───────── Tenants & access ─────────

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  city      String       @default("")
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())

  subscription  Subscription?
  modules       TenantModule[]
  users         User[]
  finderListing FinderListing?
}

model Subscription {
  id        String             @id @default(cuid())
  tenantId  String             @unique
  planId    String
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  expiresAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])
}

// Per-tenant module state. "Available" is computed (plan modules ∪ active add-ons);
// this row records installation and add-on purchases.
model TenantModule {
  tenantId   String
  moduleId   String
  installed        Boolean   @default(true)
  installedVersion String? // module version at install time (informational; tenants run the current code)
  addon            Boolean   @default(false)
  addonUntil       DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([tenantId, moduleId])
}

model User {
  id           String   @id @default(cuid())
  role         Role
  name         String
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  tenantId     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  tenant       Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  staffProfile Staff?

  @@index([tenantId])
}

model AuditLog {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  actorId   String?
  actorRole String?
  action    String
  entity    String
  entityId  String?
  meta      Json?

  @@index([entity, entityId])
  @@index([at])
}

// ───────── Module: finder (platform-scoped public directory) ─────────

model FinderListing {
  id            String        @id @default(cuid())
  editCodeHash  String
  planId        String
  status        ListingStatus @default(PENDING)
  name          String
  brand         String
  phone         String
  city          String
  x             Float
  y             Float
  cats          String[]
  bio           String        @default("")
  rejectReason  String?
  // Set once the listing has paid for its plan and been provisioned as a salon (dashboard, bookable staff).
  tenantId      String?       @unique
  // Edits to an already-published listing wait here; the live version stays public until approved.
  pendingEdit   Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  plan    Plan           @relation(fields: [planId], references: [id])
  tenant  Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  staff   FinderStaff[]
  reviews FinderReview[]
  leads   FinderLead[]

  @@index([status, city])
}

model FinderStaff {
  id        String        @id @default(cuid())
  listingId String
  staffId   String? // the salon's Staff row created at provisioning (the dashboard is the source of truth afterwards)
  name      String
  cats      String[]
  listing   FinderListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model FinderReview {
  id        String        @id @default(cuid())
  listingId String
  name      String
  rating    Int
  text      String
  createdAt DateTime      @default(now())
  listing   FinderListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
}

model FinderLead {
  id        String        @id @default(cuid())
  listingId String
  name      String
  phone     String
  note      String        @default("")
  createdAt DateTime      @default(now())
  listing   FinderListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
}

// ───────── OTP login ─────────

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

// ───────── Payments (Zarinpal) ─────────

enum PaymentKind {
  PLAN
  ADDON
  LISTING_PLAN // a finder listing paying for its plan; the salon (tenant) is created when it succeeds
  SMS_TOPUP // buying SMS credit (packageId = SmsPackage id)
  COURSE // buying an academy course (packageId = course id)
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

model Payment {
  id          String        @id @default(cuid())
  tenantId    String? // null until a LISTING_PLAN payment provisions the salon
  listingId   String?
  userId      String?
  kind        PaymentKind
  planCode    String?
  moduleId    String?
  packageId   String? // SmsPackage id for SMS_TOPUP
  months      Int           @default(1)
  amount      Int // toman, computed server-side from the plan / module price
  description String
  authority   String?       @unique
  status      PaymentStatus @default(PENDING)
  refId       String? // Zarinpal reference id after a successful verify
  cardPan     String?
  failReason  String?
  createdAt   DateTime      @default(now())
  paidAt      DateTime?

  @@index([tenantId, createdAt])
}

// ───────── Module: customers (tenant-scoped) ─────────

enum Gender {
  FEMALE
  MALE
  OTHER
}

model Customer {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  phone       String
  gender      Gender    @default(FEMALE)
  birthDate   DateTime? @db.Date // Gregorian; the UI converts to/from Jalali
  note        String    @default("")
  tags        String[]  @default([])
  allergies   String[]  @default([])
  occasions   String[]  @default([])
  // Beauty profile: { hair: {...}, skin: {...}, nail: {...} } — shape validated in the module, flexible on purpose.
  beauty      Json      @default("{}")
  source      String    @default("") // how they found the salon (walk-in, online booking, referral…)
  referredById String?
  // Archived customers disappear from lists but keep their history (other modules reference them).
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  visits       CustomerVisit[]
  appointments Appointment[]
  sales        Sale[]
  loyalty      LoyaltyAccount[]
  loyaltyTxs   LoyaltyTx[]
  memberships  Membership[]
  giftBought   GiftCard[]
  debtPayments DebtPayment[]

  @@unique([tenantId, phone])
  @@index([tenantId, archivedAt, createdAt])
  @@index([tenantId, name])
}

// Service history shown on the customer profile (the calendar/cashier modules will write these automatically).
model CustomerVisit {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  at         DateTime
  service    String
  category   String   @default("")
  staffName  String   @default("")
  price      Int      @default(0)
  note       String   @default("")
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId, at])
}

// ───────── Module: staff (tenant-scoped) ─────────

model Staff {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String?  @unique // login account (OTP) linked to this person
  name          String
  title         String   @default("") // e.g. "متخصص رنگ و مش"
  color         String   @default("#b5476b")
  phone         String   @default("")
  bio           String   @default("")
  commissionPct Int      @default(30)
  // Weekly schedule: minutes from midnight; daysOff use 0=Saturday … 6=Friday; breaks: [{ s, e, label }]
  startMin      Int      @default(540)
  endMin        Int      @default(1140)
  daysOff       Int[]    @default([6])
  breaks        Json     @default("[]")
  active        Boolean  @default(true) // inactive = no longer bookable; counts against the plan's staff limit only while active
  listed        Boolean  @default(true) // shown on the public finder / marketplace
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  leaves       StaffLeave[]
  services     ServiceStaff[]
  appointments Appointment[]

  @@index([tenantId, active])
}

model StaffLeave {
  id       String   @id @default(cuid())
  tenantId String
  staffId  String
  fromDate DateTime @db.Date
  toDate   DateTime @db.Date
  reason   String   @default("")
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, staffId, fromDate])
}

// ───────── Module: services (tenant-scoped) ─────────

model Service {
  id            String    @id @default(cuid())
  tenantId      String
  category      String
  name          String
  price         Int
  durationMin   Int
  materials     String    @default("")
  materialCost  Int       @default(0)
  commissionPct Int       @default(30)
  capacity      Int       @default(1) // simultaneous clients
  discountNote  String    @default("")
  packageNote   String    @default("")
  active        Boolean   @default(true) // false = visible to staff but not bookable
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  staff        ServiceStaff[]
  appointments Appointment[]

  @@index([tenantId, archivedAt, category])
}

model ServiceStaff {
  serviceId String
  staffId   String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([serviceId, staffId])
}

// ───────── Module: calendar (tenant-scoped) ─────────

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_SERVICE
  DONE
  CANCELED
  NO_SHOW
}

enum AppointmentSource {
  STAFF
  ONLINE
}

enum WaitStatus {
  WAITING
  BOOKED
  CANCELED
}

// Times are the salon's local calendar (Asia/Tehran): a date plus minutes from midnight.
// The database itself refuses overlapping active appointments for one staff member
// (EXCLUDE constraint "appt_no_overlap", added in the migration), so concurrent bookings can't double-book.
model Appointment {
  id           String            @id @default(cuid())
  tenantId     String
  customerId   String
  staffId      String
  serviceId    String?
  // Snapshot at booking time: later edits to the service don't rewrite history.
  serviceName  String
  category     String            @default("")
  price        Int               @default(0)
  date         DateTime          @db.Date
  startMin     Int
  durationMin  Int
  status       AppointmentStatus @default(CONFIRMED)
  source       AppointmentSource @default(STAFF)
  note         String            @default("")
  cancelReason String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Restrict)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  sales    Sale[]

  @@index([tenantId, date, staffId])
  @@index([tenantId, customerId, date])
}

model WaitlistEntry {
  id         String     @id @default(cuid())
  tenantId   String
  name       String
  phone      String
  serviceId  String
  staffId    String? // null = any staff
  fromDate   DateTime   @db.Date
  toDate     DateTime   @db.Date
  note       String     @default("")
  status     WaitStatus @default(WAITING)
  createdAt  DateTime   @default(now())

  @@index([tenantId, status, fromDate])
}

model CalendarSettings {
  tenantId      String  @id
  // 7 entries, 0 = Saturday … 6 = Friday: { open, start, end } (minutes from midnight)
  hours         Json
  onlineEnabled Boolean @default(true)
  autoConfirm   Boolean @default(false)
  leadHours     Int     @default(2) // minimum notice for online bookings
  cancelHours   Int     @default(12)
  stepMin       Int     @default(30) // slot grid
}

// ───────── Module: cashier (tenant-scoped; amounts are whole toman) ─────────

enum SaleStatus {
  PAID
  DEBT
  VOID
}

enum LineKind {
  SERVICE
  PRODUCT
  OTHER
  GIFT // a gift card being sold: a liability, not revenue
}

enum PayMethod {
  CASH
  CARD
  ONLINE
  WALLET // paid from the customer's club wallet (loyalty module); not cash in the till
  GIFT // paid with a gift card (giftcards module); not cash in the till
}

model Sale {
  id           String     @id @default(cuid())
  tenantId     String
  number       Int // per-salon invoice number (atomic counter)
  date         DateTime   @db.Date // salon-local day the invoice belongs to
  customerId   String?
  customerName String     @default("")
  apptId       String?
  subtotal     Int
  discountPct  Int        @default(0)
  discount     Int        @default(0)
  total        Int
  paid         Int // received at the till when the invoice was issued
  debt         Int        @default(0) // still owed; later payments reduce it
  status       SaleStatus
  note         String     @default("")
  voidReason   String?
  voidedAt     DateTime?
  createdById  String?
  createdAt    DateTime   @default(now())

  customer Customer?       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  appt     Appointment?    @relation(fields: [apptId], references: [id], onDelete: SetNull)
  lines    SaleLine[]
  payments SalePayment[]

  @@unique([tenantId, number])
  @@index([tenantId, date])
  @@index([tenantId, customerId, status])
}

model SaleLine {
  id            String   @id @default(cuid())
  saleId        String
  kind          LineKind
  refId         String? // service id for SERVICE lines
  name          String
  qty           Int
  price         Int
  staffId       String? // who performed it (commission)
  commissionPct Int      @default(0)
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

model SalePayment {
  id     String    @id @default(cuid())
  saleId String
  method PayMethod
  amount Int
  ref    String    @default("")
  sale   Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

model Expense {
  id        String    @id @default(cuid())
  tenantId  String
  date      DateTime  @db.Date
  title     String
  amount    Int
  method    PayMethod // CASH or CARD only (enforced by the API)
  category  String    @default("")
  createdAt DateTime  @default(now())

  @@index([tenantId, date])
}

model DebtPayment {
  id         String    @id @default(cuid())
  tenantId   String
  customerId String
  date       DateTime  @db.Date
  amount     Int
  method     PayMethod
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([tenantId, date])
}

// A closed day is locked: no new invoices, voids, expenses or debt payments dated that day until it is reopened.
model DayClosing {
  tenantId     String
  date         DateTime @db.Date
  expectedCash Int
  countedCash  Int
  note         String   @default("")
  closedById   String?
  closedAt     DateTime @default(now())

  @@id([tenantId, date])
}

// Atomic per-tenant counters (invoice numbers).
model Sequence {
  tenantId String
  key      String
  value    Int      @default(0)

  @@id([tenantId, key])
}

// ───────── Platform settings (admin-editable key/value) ─────────

model PlatformSetting {
  key   String @id
  value Json
}

// ───────── Module: sms (tenant-scoped; credit is whole toman) ─────────

enum SmsKind {
  MANUAL
  CONFIRM
  MOVED
  CANCEL
  REMINDER_24
  REMINDER_2
  THANKS
  BIRTHDAY
  CAMPAIGN
  REVIEW
}

enum SmsStatus {
  QUEUED
  SENT
  FAILED
  BLOCKED // not enough credit — nothing was sent or charged
}

enum SmsTxKind {
  TOPUP
  BONUS
  SEND
  REFUND
  ADJUST
}

model SmsAccount {
  tenantId     String   @id
  balance      Int      @default(0)
  lowThreshold Int      @default(20000)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SmsMessage {
  id          String    @id @default(cuid())
  tenantId    String
  customerId  String?
  phone       String
  text        String
  parts       Int
  cost        Int // toman charged (0 when BLOCKED)
  kind        SmsKind
  status      SmsStatus
  reason      String?
  providerRef String?
  // appointment id (or customer:year for birthdays): an automatic message is sent at most once per (kind, relatedId)
  relatedId   String?
  createdAt   DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
}

model SmsTx {
  id           String    @id @default(cuid())
  tenantId     String
  delta        Int
  balanceAfter Int
  kind         SmsTxKind
  ref          String?
  note         String    @default("")
  createdAt    DateTime  @default(now())

  @@index([tenantId, createdAt])
}

model SmsPackage {
  id        String  @id @default(cuid())
  name      String
  price     Int // toman the salon pays
  bonusPct  Int     @default(0) // extra credit on top of the price
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}

model SmsScenario {
  tenantId String
  kind     SmsKind
  enabled  Boolean
  template String

  @@id([tenantId, kind])
}

// ───────── Module: loyalty (customer club; points + wallet in whole toman) ─────────

enum LoyaltyTxKind {
  EARN // points for an invoice
  EARN_REVERSE // invoice voided
  REDEEM // points spent on a reward
  ADJUST // manual correction by the owner
  CASHBACK // wallet credit for an invoice
  CASHBACK_REVERSE
  REWARD_CREDIT // wallet credit from a reward
  WALLET_SPEND // wallet used as a payment method
  WALLET_REFUND // invoice voided
  WALLET_ADJUST
  REFERRAL // points for bringing in a friend
}

model LoyaltyConfig {
  tenantId  String   @id
  tiers     Json
  earn      Json
  rewards   Json
  cashback  Json
  updatedAt DateTime @updatedAt
}

model LoyaltyAccount {
  tenantId   String
  customerId String
  points     Int      @default(0) // spendable
  lifetime   Int      @default(0) // ever earned — drives the tier, which never drops
  tier       String   @default("")
  wallet     Int      @default(0) // toman
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([tenantId, customerId])
}

model LoyaltyTx {
  id          String        @id @default(cuid())
  tenantId    String
  customerId  String
  kind        LoyaltyTxKind
  points      Int           @default(0)
  wallet      Int           @default(0)
  pointsAfter Int
  walletAfter Int
  ref         String? // sale id / reward id
  note        String        @default("")
  createdAt   DateTime      @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId, createdAt])
}

// ───────── Module: inventory (retail products & consumables; whole-toman prices) ─────────

enum ProductKind {
  RETAIL // sold on invoices
  CONSUMABLE // used up in services
}

enum StockMoveKind {
  RECEIVE
  SALE
  SALE_VOID
  ADJUST
}

model Product {
  id         String      @id @default(cuid())
  tenantId   String
  name       String
  kind       ProductKind @default(RETAIL)
  price      Int         @default(0) // selling price (retail)
  cost       Int         @default(0) // last purchase price
  stock      Int         @default(0)
  reorder    Int         @default(3) // low-stock threshold
  supplier   String      @default("")
  archivedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  moves StockMove[]

  @@index([tenantId, archivedAt])
}

model StockMove {
  id         String        @id @default(cuid())
  tenantId   String
  productId  String
  kind       StockMoveKind
  delta      Int
  stockAfter Int
  unitCost   Int?
  ref        String? // sale id for SALE / SALE_VOID
  note       String        @default("")
  createdAt  DateTime      @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId, createdAt])
}

// ───────── Module: campaigns (SMS to a rule-based audience) ─────────

enum CampaignStatus {
  SCHEDULED
  SENDING
  SENT
  CANCELED
}

model Campaign {
  id            String         @id @default(cuid())
  tenantId      String
  name          String
  message       String
  segment       Json
  status        CampaignStatus
  scheduledFor  DateTime?
  sentAt        DateTime?
  audienceCount Int            @default(0)
  sentCount     Int            @default(0)
  failedCount   Int            @default(0)
  skippedCount  Int            @default(0) // over the per-customer frequency cap or no credit
  createdAt     DateTime       @default(now())

  @@index([tenantId, createdAt])
  @@index([status, scheduledFor])
}

// ───────── Module: reviews (post-service survey; good → public, bad → private to the owner) ─────────

enum ReviewRoute {
  PUBLIC
  PRIVATE
}

model Review {
  id          String       @id @default(cuid())
  tenantId    String
  saleId      String?
  customerId  String?
  staffId     String?
  serviceName String       @default("")
  tokenHash   String       @unique // sha256 of the secret in the survey link
  rating      Int? // 1-5, null until answered
  comment     String       @default("")
  route       ReviewRoute?
  resolved    Boolean      @default(false)
  reply       String?
  repliedAt   DateTime?
  answeredAt  DateTime?
  createdAt   DateTime     @default(now())

  @@unique([tenantId, saleId])
  @@index([tenantId, createdAt])
}

model ReviewConfig {
  tenantId  String @id
  threshold Int    @default(4) // ratings at or above this are invited to be public
}

// ───────── Module: referral (customers invite friends; the referrer earns loyalty points on the friend's first invoice) ─────────

model ReferralConfig {
  tenantId    String  @id
  enabled     Boolean @default(false)
  referrerPts Int     @default(100)
  friendOff   Int     @default(10) // % discount offered on the friend's first invoice
}

model ReferralLink {
  tenantId   String
  customerId String
  code       String @unique

  @@id([tenantId, customerId])
}

model ReferralReward {
  id         String   @id @default(cuid())
  tenantId   String
  referrerId String
  friendId   String
  saleId     String
  points     Int
  createdAt  DateTime @default(now())

  @@unique([tenantId, friendId]) // a friend rewards their referrer once, ever
  @@index([tenantId, referrerId])
}

// ───────── Module: memberships (prepaid packages: validity period + included sessions + a service discount) ─────────

enum MembershipStatus {
  ACTIVE
  CANCELED
}

model MembershipPlan {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  price       Int
  months      Int // validity in 30-day months
  credits     Int // sessions included
  creditLabel String    @default("")
  discountPct Int       @default(0) // discount offered on services while the membership is valid
  perks       String[]  @default([])
  active      Boolean   @default(true)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, archivedAt])
}

model Membership {
  id           String           @id @default(cuid())
  tenantId     String
  customerId   String
  planId       String?
  planName     String // snapshot: later plan edits don't rewrite what was sold
  discountPct  Int              @default(0)
  startDate    DateTime         @db.Date
  expiryDate   DateTime         @db.Date
  credits      Int // sessions left
  creditsTotal Int
  creditLabel  String           @default("")
  status       MembershipStatus @default(ACTIVE)
  saleId       String?          @unique
  createdAt    DateTime         @default(now())

  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  uses     MembershipUse[]

  @@index([tenantId, customerId])
  @@index([tenantId, status, expiryDate])
}

model MembershipUse {
  id           String   @id @default(cuid())
  tenantId     String
  membershipId String
  note         String   @default("")
  at           DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId])
}

// ───────── Module: giftcards (prepaid value in whole toman; the code is a bearer secret, stored only as a hash) ─────────

enum GiftStatus {
  ACTIVE
  USED
  VOID
}

enum GiftTxKind {
  ISSUE
  SPEND
  REFUND // an invoice paid with the card was voided
  VOID
}

model GiftCard {
  id        String     @id @default(cuid())
  tenantId  String
  codeHash  String     @unique
  last4     String
  amount    Int
  balance   Int
  status    GiftStatus @default(ACTIVE)
  buyerId   String?
  fromName  String
  toName    String
  toPhone   String
  occasion  String     @default("")
  message   String     @default("")
  saleId    String?    @unique // the invoice that sold it
  createdAt DateTime   @default(now())

  buyer Customer?   @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  txs   GiftCardTx[]

  @@index([tenantId, createdAt])
}

model GiftCardTx {
  id           String     @id @default(cuid())
  tenantId     String
  cardId       String
  kind         GiftTxKind
  delta        Int
  balanceAfter Int
  ref          String? // sale id
  createdAt    DateTime   @default(now())

  card GiftCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

// ───────── Module: network (salons request services from the platform's partner network; the platform team follows up) ─────────

enum NetworkStatus {
  SUBMITTED
  REVIEWING
  ANSWERED
}

model NetworkRequest {
  id        String        @id @default(cuid())
  tenantId  String
  category  String
  note      String        @default("")
  status    NetworkStatus @default(SUBMITTED)
  response  String? // what the platform team told the salon
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
}

// ───────── Module: academy (platform-run courses salons and their staff take) ─────────

enum CourseAudience {
  ALL
  OWNER
  STAFF
}

model Course {
  id          String         @id @default(cuid())
  title       String
  description String         @default("")
  audience    CourseAudience @default(ALL)
  hours       Float          @default(1)
  price       Int            @default(0) // 0 = free
  inPlans     String[]       @default([]) // plan codes that get it at no charge
  published   Boolean        @default(false)
  lessons     Json // [{ title, minutes, body }]
  createdAt   DateTime       @default(now())

  enrollments Enrollment[]
}

model Enrollment {
  id          String    @id @default(cuid())
  tenantId    String
  userId      String
  courseId    String
  done        Int[]     @default([]) // completed lesson indexes
  paid        Int       @default(0)
  completedAt DateTime?
  serial      String?   @unique // certificate number, set on completion
  createdAt   DateTime  @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId])
  @@index([tenantId])
}
